{
  "name": "ciclo-seguro-lima",
  "version": "1.0.0",
  "description": "CicloSeguro Lima: rutas seguras, reporte de incidentes y estacionamientos para ciclistas",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "test:report": "node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results.xml \"tests/*.test.js\"",
    "start": "npx --yes serve dist"
  },
  "license": "MIT"
}
